      <a
        href="https://images.start.gg/images/profileWidgetPageLayout/4017531/image-ee7e160e137d139f709ce1ae2797f28a.png"
        target="_blank"
        class="card-button"
        data-umami-event="schedule-clicked"
        data-umami-event-name="Riptide 2026"
        >Schedule</a
      >
      <a
        href="https://www.twitch.tv/btssmash"
        target="_blank"
        class="card-button stream-button"
        data-umami-event="stream-clicked"
        data-umami-event-name="Riptide 2026"
        >Stream</a
      >
    </div>
  </div>
</div>

