<!doctype html>
<html lang="en">
  <head>
    <meta name="darkreader-lock">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- paper color of the background artwork, so safari tints its own toolbars
         to match the page instead of sampling the black body background -->
    <meta name="theme-color" content="#fbf5e2" />
    <meta
      name="description"
      content="The Largest Upcoming Melee Events | Next major: Riptide 2026 • September 11 - September 13 • Sandusky, OH • 565 attendees"
    />
    <link rel="stylesheet" href="styles.css" />
    <link rel="icon" href="assets/favicon/favicon.png" />
