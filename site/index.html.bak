>
  <img
    src="assets/cards/riptide20264.webp"
    alt="Riptide 2026 banner image"
    class="image"
  />
  <div class="card-content">
    <h2>Riptide 2026</h2>
    <h4>September 11 - September 13</h4>
    <div class="featured-players">
      <u>Featured Players</u>
      <ul class="featured-players-columns">
        <li>Hungrybox</li>
        <li>Axe</li>
        <li>Wizzrobe</li>
        <li>Krudo</li>
        <li>Joshman</li>
        <li>Jmook</li>
        <li>lloD</li>
        <li>Ginger</li>
